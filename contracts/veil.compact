// VEIL: compiled with Compact 0.30.0; real proofs verified on an offline ledger.
// UI personas use this same Compact persistentHash construction.
pragma language_version >= 0.20;

import CompactStandardLibrary;

export ledger issuerAuthority: Bytes<32>;
export ledger roots: MerkleTree<8, Bytes<32>>;
export ledger revokedPersonas: Set<Bytes<32>>;
export ledger usedRequests: Set<Bytes<32>>;
export ledger authorizations: Set<Bytes<32>>;
export ledger selectedLinks: Set<Bytes<32>>;

witness rootSecret(): Bytes<32>;
witness issuerSecret(): Bytes<32>;
witness membershipPath(): MerkleTreePath<8, Bytes<32>>;

constructor(issuer: Bytes<32>) { issuerAuthority = disclose(issuer); }

circuit rootCommitment(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "VEIL/root/v1"), secret]);
}
circuit personaId(secret: Bytes<32>, context: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "VEIL/persona/v1"), secret, context]);
}
circuit checkedRoot(): Bytes<32> {
  const secret = rootSecret();
  const path = membershipPath();
  assert(path.leaf == rootCommitment(secret), "Wrong root membership leaf");
  assert(roots.checkRoot(disclose(merkleTreePathRoot<8, Bytes<32>>(path))), "Root not enrolled");
  return secret;
}

export circuit enroll(commitment: Bytes<32>): [] {
  const authority = persistentHash<Vector<2, Bytes<32>>>([pad(32, "VEIL/issuer/v1"), issuerSecret()]);
  assert(authority == issuerAuthority, "Issuer required");
  roots.insert(disclose(commitment));
}

// requestDigest must bind the verifier's complete action/amount/expiry/domain.
// This circuit binds a digest; policy fields are enforced by the local Core.
export circuit authorize(context: Bytes<32>, requestDigest: Bytes<32>, nonce: Bytes<32>): [] {
  const p = disclose(personaId(checkedRoot(), context));
  assert(!revokedPersonas.member(p), "Persona revoked");
  const request = disclose(persistentHash<Vector<3, Bytes<32>>>([pad(32, "VEIL/request/v1"), p, nonce]));
  assert(!usedRequests.member(request), "Request replay");
  usedRequests.insert(request);
  authorizations.insert(disclose(persistentHash<Vector<3, Bytes<32>>>([p, requestDigest, nonce])));
}

// Wave 2 (2026-10): circuit-enforced policy.
//
// The Wave 1 `authorize` circuit above binds a Core-computed requestDigest, so
// amount/action/expiry policy was enforced by the Core. This circuit moves one
// policy check into the circuit itself: the amount cap is asserted here, so a
// Core that skips (or a caller that bypasses) its own pre-checks still cannot
// produce a valid authorization proof for an over-cap request.
//
// amount/maxAmount are public circuit inputs committed in the proof transcript;
// disclosing them binds the enforced policy to this authorization explicitly.
export circuit authorizeWithPolicy(
  context: Bytes<32>,
  action: Bytes<32>,
  amount: Uint<64>,
  maxAmount: Uint<64>,
  nonce: Bytes<32>
): [] {
  const p = disclose(personaId(checkedRoot(), context));
  assert(!revokedPersonas.member(p), "Persona revoked");
  const request = disclose(persistentHash<Vector<3, Bytes<32>>>([pad(32, "VEIL/request/v1"), p, nonce]));
  assert(!usedRequests.member(request), "Request replay");
  assert(disclose(amount) <= disclose(maxAmount), "Amount exceeds policy");
  usedRequests.insert(request);
  authorizations.insert(disclose(persistentHash<Vector<4, Bytes<32>>>(
    [pad(32, "VEIL/policyAuth/v1"), p, action, request])));
}

export circuit linkSelected(contextA: Bytes<32>, contextB: Bytes<32>, challenge: Bytes<32>): [] {
  assert(contextA != contextB, "Select distinct contexts");
  const secret = checkedRoot();
  const a = disclose(personaId(secret, contextA));
  const b = disclose(personaId(secret, contextB));
  assert(!revokedPersonas.member(a), "First persona revoked");
  assert(!revokedPersonas.member(b), "Second persona revoked");
  selectedLinks.insert(disclose(persistentHash<Vector<4, Bytes<32>>>([pad(32, "VEIL/link/v1"), a, b, challenge])));
}

export circuit revoke(context: Bytes<32>): [] {
  revokedPersonas.insert(disclose(personaId(checkedRoot(), context)));
}

