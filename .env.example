# Server / CLI only. Never use VITE_ or expose these values in the frontend.
# Keep execution disabled until a dedicated, funded Devnet signer is ready.
VEIL_SOLANA_ENABLED=0
VEIL_SOLANA_KEYPAIR_PATH=.private/solana-devnet-keypair.json
# Optional: absent key selects the public Solana Devnet RPC.
HELIUS_API_KEY=
# Opt-in external agent protocol; requires VEIL_SOLANA_ENABLED=1.
VEIL_AGENTS_ENABLED=0
VEIL_AGENT_DB_PATH=.private/agents.sqlite
